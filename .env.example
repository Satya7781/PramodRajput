# ─── App Configuration ────────────────────────────────────────────────────────
# Base URL used by server-side fetch calls (Next.js SSR). No trailing slash.
# For local development: http://localhost:3000
# For production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Database host (localhost for local dev, IP/hostname for VPS)
DB_HOST=localhost

# Database port (default PostgreSQL port is 5432)
DB_PORT=5432

# Database name
DB_NAME=pramod_rajput

# Database user
DB_USER=pramod_user

# Database password - CHANGE THIS TO A STRONG PASSWORD
DB_PASSWORD=change_this_strong_password

# Set to "true" if your VPS requires SSL (recommended for remote connections)
# For local development, use "false"
DB_SSL=false

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong secret using: openssl rand -hex 64
# IMPORTANT: Change this in production to a random 64+ character string
JWT_SECRET=replace_with_a_very_long_random_secret_string_at_least_64_chars

# JWT token expiration time (examples: 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Uploaded files are stored in /public/uploads/ by default.
# The NEXT_PUBLIC_APP_URL above is used to build absolute URLs for uploaded files.
# No additional configuration needed unless you want to use external storage (S3, etc.)

# ─── Node Environment ─────────────────────────────────────────────────────────
# Set to "production" for production deployment
# Set to "development" for local development
NODE_ENV=development

# ─── SEO / Metadata (optional) ────────────────────────────────────────────────
# These override the default title/description used in <head> metadata.
# The site-settings DB values control what is shown in the UI at runtime.
# NEXT_PUBLIC_SITE_NAME=Pramod Rajput
# NEXT_PUBLIC_SITE_TAGLINE=Serving People, Building Tomorrow
# NEXT_PUBLIC_SITE_DESC=Official digital platform...
# NEXT_PUBLIC_OG_IMAGE=https://yourdomain.com/og-image.jpg
